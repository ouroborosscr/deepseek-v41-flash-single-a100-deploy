# Copy this file to .env, update the paths, then export CONFIG_FILE=.env.

export DEPLOY_ROOT=/data/deepseek-v41-flash
export MODEL_DIR=/data/models/DeepSeek-V4.1-Flash
export GGUF_DIR=/data/deepseek-v41-flash/gguf
export RUNTIME_DIR=/data/deepseek-v41-flash/llama.cpp

export MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
export MODEL_ALIAS=DeepSeek-V4.1-Flash
export CONVERT_PYTHON=/data/deepseek-v41-flash/venv-convert/bin/python

export GPU_INDEX=0
export CUDA_ROOT=/usr/local/cuda-12.8
export CUDA_ARCH=80

export HOST=127.0.0.1
export PORT=7888
export CONTEXT_SIZE=8192
export PARALLEL=1
export CPU_THREADS=32
export VRAM_CACHE_GIB=60
export HOST_CACHE_GIB=120

# Recommended when HOST is not loopback.
# export API_KEY=replace-with-a-long-random-token

# Required only when deliberately exposing an unauthenticated public listener.
export ALLOW_UNAUTHENTICATED_PUBLIC=0
